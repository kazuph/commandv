{
  "name": "commandv",
  "version": "1.0.0",
  "description": "An instant previewer for Claude Artifacts. Just paste your component code and see it rendered immediately.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazuph/commandv.git"
  },
  "keywords": [
    "react",
    "component",
    "preview",
    "paste",
    "visualizer",
    "cloudflare",
    "workers",
    "hono"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev server-build/index.js",
    "deploy": "$npm_execpath run build && wrangler deploy server-build/index.js",
    "lint": "oxlint src/",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.4",
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.2.7",
    "hono": "^4.12.18",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.45",
    "lodash": "^4.18.1",
    "lucide-react": "^0.487.0",
    "marked": "^15.0.12",
    "mermaid": "^11.14.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.25.3",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript/native-preview": "7.0.0-dev.20260506.1",
    "autoprefixer": "^10.5.0",
    "oxlint": "^1.63.0",
    "postcss": "^8.5.14",
    "vite": "^8.0.10",
    "wrangler": "^4.88.0"
  }
}
